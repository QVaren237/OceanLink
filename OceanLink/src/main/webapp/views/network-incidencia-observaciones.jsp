<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,pe.edu.oceanlink.bean.Incidencia" %>
<%! private String e(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<% Incidencia i=(Incidencia)request.getAttribute("incidencia"); List<Map<String,Object>> lista=(List<Map<String,Object>>)request.getAttribute("observaciones"); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Seguimiento de incidencia</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/styles.css"></head><body><main style="max-width:900px;margin:35px auto;padding:24px">
<%if(i==null){%><h1>Incidencia no encontrada</h1><%}else{%><h1>Seguimiento: <%=e(i.getCodigo())%></h1><p><strong><%=e(i.getTitulo())%></strong> · <%=e(i.getEstado())%></p>
<h2>Registrar observación o restauración</h2><form method="post" action="<%=request.getContextPath()%>/IncidenciaServlet"><input type="hidden" name="action" value="observar"><input type="hidden" name="id" value="<%=i.getIdIncidencia()%>"><label>Tipo de registro</label><select class="input" name="tipo"><option>Observación</option><option>Restauración</option></select><label>Detalle</label><textarea class="input" name="observacion" rows="4" maxlength="2000" required></textarea><button class="btn btn-primary" type="submit">Guardar registro</button></form>
<h2>Historial</h2><%if(lista==null||lista.isEmpty()){%><p>Aún no hay observaciones registradas.</p><%}else for(Map<String,Object> o:lista){%><article style="padding:14px;margin:10px 0;border:1px solid #dbe9e7;border-radius:10px"><strong><%=e(o.get("tipo"))%></strong> · <%=e(o.get("fechaRegistro"))%><p><%=e(o.get("observacion"))%></p><small>Registrado por: <%=e(o.get("usuarioNombre"))%></small></article><%}%><%}%><p><a href="<%=request.getContextPath()%>/IncidenciaServlet">Volver a incidencias</a></p></main></body></html>