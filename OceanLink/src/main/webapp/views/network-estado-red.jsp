<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %>
<%! private String e(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<% List<Map<String,Object>> lista=(List<Map<String,Object>>)request.getAttribute("lista");String buscar=request.getParameter("buscar")==null?"":request.getParameter("buscar");String estado=request.getParameter("estado")==null?"":request.getParameter("estado"); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Estado de red · OceanLink</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/styles.css"></head><body><main style="max-width:1200px;margin:35px auto;padding:24px"><p>NETWORK OPERATOR</p><h1>Estado de la red</h1><p>Datos obtenidos directamente de los segmentos y estaciones de la base de datos.</p>
<form method="get" action="<%=request.getContextPath()%>/EstadoRedServlet" style="display:flex;gap:10px;flex-wrap:wrap;margin:20px 0"><input class="input" name="buscar" placeholder="Buscar por código, origen o destino" value="<%=e(buscar)%>"><select class="input" name="estado"><option value="">Todos los estados</option><%for(String x:new String[]{"Operativo","Operativa","En mantenimiento","Interrumpido","Activo","Inactivo"}){%><option <%=x.equals(estado)?"selected":""%>><%=x%></option><%}%></select><button class="btn btn-primary">Filtrar</button></form>
<div style="overflow-x:auto"><table class="table" style="width:100%;border-collapse:collapse"><thead><tr><th>Segmento</th><th>Origen</th><th>Destino</th><th>Capacidad total (Gbps)</th><th>Utilizada</th><th>Reservada</th><th>Utilización (%)</th><th>Estado</th></tr></thead><tbody><%if(lista==null||lista.isEmpty()){%><tr><td colspan="8">No hay segmentos que coincidan con la búsqueda.</td></tr><%}else for(Map<String,Object> s:lista){%><tr><td><%=e(s.get("codigo"))%></td><td><%=e(s.get("origen"))%></td><td><%=e(s.get("destino"))%></td><td><%=e(s.get("total"))%></td><td><%=e(s.get("utilizada"))%></td><td><%=e(s.get("reservada"))%></td><td><%=e(s.get("utilizacion"))%>%</td><td><%=e(s.get("estado"))%></td></tr><%}%></tbody></table></div><p><a href="<%=request.getContextPath()%>/PanelServlet">Volver al panel</a></p></main></body></html>