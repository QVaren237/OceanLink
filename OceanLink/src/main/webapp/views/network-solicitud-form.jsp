<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,pe.edu.oceanlink.bean.Solicitud" %>
<%! private String e(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<% Solicitud s=(Solicitud)request.getAttribute("solicitud");List<Map<String,Object>> clientes=(List<Map<String,Object>>)request.getAttribute("clientes");List<Map<String,Object>> rutas=(List<Map<String,Object>>)request.getAttribute("rutas");boolean editar=s!=null; %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Solicitud de capacidad</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/network-operator.css"></head><body><main style="max-width:800px;margin:35px auto;padding:24px"><h1><%=editar?"Editar solicitud":"Nueva solicitud de capacidad"%></h1><form method="post" action="<%=request.getContextPath()%>/SolicitudServlet"><input type="hidden" name="action" value="<%=editar?"actualizar":"crear"%>"><%if(editar){%><input type="hidden" name="id" value="<%=s.getIdSolicitud()%>"><p>Código: <strong><%=e(s.getCodigo())%></strong></p><%}%>
<label>Cliente</label><select class="input" name="idCliente" required><option value="">Selecciona cliente</option><%if(clientes!=null)for(Map<String,Object> c:clientes){%><option value="<%=c.get("id")%>" <%=editar&&s.getIdCliente()==((Number)c.get("id")).intValue()?"selected":""%>><%=e(c.get("nombre"))%></option><%}%></select>
<label>Ruta</label><select class="input" name="idRuta" required><option value="">Selecciona ruta</option><%if(rutas!=null)for(Map<String,Object> r:rutas){%><option value="<%=r.get("id")%>" <%=editar&&s.getIdRuta()==((Number)r.get("id")).intValue()?"selected":""%>><%=e(r.get("nombre"))%></option><%}%></select>
<label>Capacidad solicitada (Gbps)</label><input class="input" type="number" name="capacidad" min="0.01" step="0.01" required value="<%=editar?e(s.getCapacidadSolicitada()):""%>">
<label>Fecha límite</label><input class="input" type="date" name="fechaLimite" value="<%=editar?e(s.getFechaLimite()):""%>">
<label>Motivo</label><textarea class="input" name="motivo" maxlength="255" rows="3"><%=editar?e(s.getMotivo()):""%></textarea>
<label>Estado</label><select class="input" name="estado" required><%for(String x:new String[]{"Pendiente","En revisión","Aprobada","Rechazada","Atendida"}){%><option <%=editar&&x.equals(s.getEstado())?"selected":(!editar&&"Pendiente".equals(x))?"selected":""%>><%=x%></option><%}%></select>
<label>Observación</label><textarea class="input" name="observacion" maxlength="255" rows="3"><%=editar?e(s.getObservacion()):""%></textarea>
<button class="btn btn-primary" type="submit">Guardar</button> <a class="btn" href="<%=request.getContextPath()%>/SolicitudServlet">Cancelar</a></form></main></body></html>