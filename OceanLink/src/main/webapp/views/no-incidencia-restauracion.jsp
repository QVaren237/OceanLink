<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,pe.edu.oceanlink.bean.*" %>
<%!
 private String h(Object v) { return v==null?"—":v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;"); }
 private String pill(String v) {
   if (v==null) return "pill-neutral";
   if (Arrays.asList("Crítica","Detectada","Fuera de servicio","Rechazada").contains(v)) return "pill-crit";
   if (Arrays.asList("Operativo","Servicio restaurado","Aprobada","Baja").contains(v)) return "pill-ok";
   if (Arrays.asList("Media","En mantenimiento").contains(v)) return "pill-info";
   return "Cerrada".equals(v)?"pill-neutral":"pill-warn";
 }
%>
<% String ctx=request.getContextPath(); %>
<% request.setAttribute("tituloNO","Registrar restauración");request.setAttribute("seccionNO","incidencias");
Incidencia incidencia=(Incidencia)request.getAttribute("incidencia");
%>
<jsp:include page="/views/no-inicio.jsp"/>
<% if(incidencia==null){ %><div class="card center-state"><h2>Incidencia no encontrada</h2><a class="btn btn-outline" href="<%=ctx%>/NetworkOperatorServlet?action=incidencias">Volver</a></div><% }else{ %><% if(request.getAttribute("error")!=null){ %><div class="banner banner-err" role="alert"><%=h(request.getAttribute("error"))%></div><% } %><div class="back-row"><a class="btn btn-outline" href="<%=ctx%>/NetworkOperatorServlet?action=detalleIncidencia&amp;id=<%=incidencia.getIdIncidencia()%>">Volver</a></div><div class="page-head"><div><h1>Registrar restauración</h1><div class="psub">Documenta la recuperación del servicio afectado.</div></div></div><div class="card card-pad"><% if(Boolean.TRUE.equals(request.getAttribute("restauracionHabilitada"))){ %><form method="post" action="<%=ctx%>/NetworkOperatorServlet" data-confirm-form class="form-grid" style="max-width:700px"><input type="hidden" name="action" value="registrarRestauracion"><input type="hidden" name="id" value="<%=incidencia.getIdIncidencia()%>"><div id="noFormView"><div class="field"><label>Incidencia</label><div class="ro-field"><%=h(incidencia.getCodigo())%> — <%=h(incidencia.getTitulo())%></div></div><div class="field"><label>Estado previo</label><div class="ro-field"><%=h(incidencia.getEstado())%></div></div><div class="field"><label>Fecha y hora de restauración <span class="required-mark">*</span></label><div class="ro-field"><%=java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))%> — se registra automáticamente</div><span class="validation-message">Este campo es obligatorio.</span></div><div class="field"><label for="no-field-1">Resultado <span class="required-mark">*</span></label><select id="no-field-1" name="resultado" class="input" required><option selected>Servicio restablecido</option><option>Restauración parcial</option></select><span class="validation-message">Este campo es obligatorio.</span></div><div class="field"><label for="no-field-2">Observaciones <span class="required-mark">*</span></label><textarea id="no-field-2" name="observaciones" class="input" rows="5" placeholder="Describe las acciones realizadas y la verificación del servicio..." required></textarea><span class="validation-message">Este campo es obligatorio.</span><div class="hint">Registra el resultado de la restauración.</div></div><div class="form-actions"><a class="btn btn-outline" href="<%=ctx%>/NetworkOperatorServlet?action=detalleIncidencia&amp;id=<%=incidencia.getIdIncidencia()%>">Cancelar</a><button class="btn btn-primary" type="submit">Registrar restauración</button></div></div><div id="noConfirmView" hidden><div class="page-head"><div><h1>Confirmar restauración</h1><div class="psub">Revisa la información antes de confirmar.</div></div></div><div class="card card-pad" style="max-width:720px"><div class="info-strip"><div class="ii">!</div><div><div class="it">CONFIRMAR OPERACIÓN</div><div class="id">La información se guardará al confirmar.</div></div></div><div id="noConfirmFields"></div><div class="form-actions"><button type="button" class="btn btn-outline" id="noBack">Volver a editar</button><button type="button" class="btn btn-primary" id="noSave">Confirmar</button></div></div></div></form><% }else{ %><div class="notice-soft">La restauración se habilitará cuando se hayan finalizado los mantenimientos correctivos de todos los segmentos afectados, con su resultado registrado.</div><% } %></div><% } %><script>
(function(){const form=document.querySelector('[data-confirm-form]');if(!form)return;let confirmed=false;
const original=document.getElementById('noFormView'),review=document.getElementById('noConfirmView'),fields=document.getElementById('noConfirmFields');
form.addEventListener('submit',function(e){if(confirmed)return;e.preventDefault();if(!form.reportValidity())return;
 const checks=Array.from(form.querySelectorAll('input[name="segmentos"]'));if(checks.length&&!checks.some(c=>c.checked)){const error=document.getElementById('noSegmentError');error.hidden=false;return;}
 fields.replaceChildren();form.querySelectorAll('.field, .data-list > div').forEach(function(field){
 const controls=Array.from(field.querySelectorAll('input:not([type="hidden"]),textarea,select')),readonly=field.querySelector('.ro-field');if(!controls.length&&!readonly)return;
 const label=field.querySelector('label');let title=label?label.textContent.replace('*','').trim():field.previousElementSibling?field.previousElementSibling.textContent.trim():'';
 let values=controls.filter(c=>c.type!=='checkbox'||c.checked).map(c=>c.type==='checkbox'?c.parentElement.textContent.trim():c.tagName==='SELECT'?(c.selectedOptions[0]?c.selectedOptions[0].textContent:''):c.value).filter(Boolean);
 if(!values.length&&readonly)values=[readonly.textContent.trim()];if(!values.length)return;const item=document.createElement('div');item.className='field';const l=document.createElement('label');l.textContent=title;const v=document.createElement('div');v.className='ro-field';v.textContent=values.join(' · ');item.append(l,v);fields.append(item);
 });original.hidden=true;review.hidden=false;const heading=document.querySelector('.content>.page-head');if(heading)heading.hidden=true;const card=form.closest('.card')||form;if(card)card.style.maxWidth='760px';window.scrollTo(0,0);});
 document.getElementById('noBack').onclick=()=>{review.hidden=true;original.hidden=false;const heading=document.querySelector('.content>.page-head');if(heading)heading.hidden=false;const card=form.closest('.card')||form;if(card)card.style.maxWidth='';};document.getElementById('noSave').onclick=()=>{confirmed=true;form.requestSubmit();};
})();
</script>
<jsp:include page="/views/no-fin.jsp"/>
