<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,pe.edu.oceanlink.bean.Solicitud" %>
<%! private String e(Object v){return v==null?"":String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>
<% List<Solicitud> lista=(List<Solicitud>)request.getAttribute("lista");String buscar=request.getParameter("buscar")==null?"":request.getParameter("buscar");String estado=request.getParameter("estado")==null?"":request.getParameter("estado"); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Solicitudes de capacidad · OceanLink</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/styles.css"></head><body><main style="max-width:1200px;margin:35px auto;padding:24px"><header style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap"><div><p>NETWORK OPERATOR</p><h1>Solicitudes de capacidad</h1></div><a class="btn btn-primary" href="<%=request.getContextPath()%>/SolicitudServlet?action=nuevo">+ Nueva solicitud</a></header>
<form method="get" action="<%=request.getContextPath()%>/SolicitudServlet" style="display:flex;gap:10px;flex-wrap:wrap;margin:20px 0"><input type="hidden" name="action" value="lista"><input class="input" name="buscar" placeholder="Buscar código, cliente o ruta" value="<%=e(buscar)%>"><select class="input" name="estado"><option value="">Todos los estados</option><%for(String x:new String[]{"Pendiente","En revisión","Aprobada","Rechazada","Atendida"}){%><option <%=x.equals(estado)?"selected":""%>><%=x%></option><%}%></select><button class="btn btn-primary">Buscar</button></form>
<div style="overflow-x:auto"><table class="table" style="width:100%;border-collapse:collapse"><thead><tr><th>Código</th><th>Cliente</th><th>Ruta</th><th>Capacidad</th><th>Fecha límite</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><%if(lista==null||lista.isEmpty()){%><tr><td colspan="7">No hay solicitudes registradas.</td></tr><%}else for(Solicitud s:lista){%><tr><td><%=e(s.getCodigo())%></td><td><%=e(s.getClienteNombre())%></td><td><%=e(s.getRutaNombre())%></td><td><%=e(s.getCapacidadSolicitada())%> Gbps</td><td><%=e(s.getFechaLimite())%></td><td><%=e(s.getEstado())%></td><td><a href="<%=request.getContextPath()%>/SolicitudServlet?action=editar&id=<%=s.getIdSolicitud()%>">Editar</a> <form method="post" action="<%=request.getContextPath()%>/SolicitudServlet" style="display:inline" onsubmit="return confirm('¿Eliminar esta solicitud?')"><input type="hidden" name="action" value="eliminar"><input type="hidden" name="id" value="<%=s.getIdSolicitud()%>"><button>Eliminar</button></form></td></tr><%}%></tbody></table></div><p><a href="<%=request.getContextPath()%>/PanelServlet">Volver al panel</a></p></main></body></html>